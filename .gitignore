# Whitelist approach — ignore everything by default, then unignore what should be public
*

# Files to publish on GitHub Pages
!index.html
!whydah-dashboard.html
!day*.html
!day-config.js
!CNAME
!handouts.html
!flythrough.html
!unit-at-a-glance.html
!curriculum-guide.html
!README.md
!.gitignore
!*.jpg
!*.jpeg
!*.png
!*.svg
!*.webp
!*.gif

# Favicon + web app manifest (root-level default lookup paths)
!favicon.ico
!site.webmanifest

# Subdirectories for assets
!pics/
!pics/**

# The Navigator game (whole folder is public)
!navigator/
!navigator/**

# Black Sam & the Whydah game (whole folder is public)
!black-sam/
!black-sam/**

# Photography unit (whole folder is public)
!photo/
!photo/**

# Rain-day photo scavenger hunt (added 2026-07-29)
!photohunt/
!photohunt/**
!photohunt2/
!photohunt2/**

# Classroom games hub + Parrot Flip
!games/
!games/**
!parrot-flip/
!parrot-flip/**

# Shared teacher-controlled game lock (loaded by the games + dashboard)
!games-gate.js

# Stable route for the live unit dashboard
!unit/
!unit/**

# Final-two-weeks student pages (added 2026-07-26)
!choose-your-project.html
!map-studio.html

# Vendored libraries (Leaflet — kept same-origin for school wifi filters)
!vendor/
!vendor/**

# LEAP unit planner (final draft — submission document, not a student page)
!unit-planner/
!unit-planner/**

# CI (not published by Pages — GitHub reads it from the repo)
!.github/
!.github/**
