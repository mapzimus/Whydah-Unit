+
+function parrotWingSVG(p: ReturnType<typeof parrotPalette>): string {
+  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 420">
+<defs>
+<linearGradient id="gW" x1="0" y1="150" x2="0" y2="350" gradientUnits="userSpaceOnUse">
